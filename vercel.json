{
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/cron.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/cron/earnings", "dest": "api/cron.js" },
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/earnings",
      "schedule": "0 0 * * *"
    }
  ]
}
